# === Supabase / PostgreSQL ===
# Use a URL do POOLER (porta 6543, modo Transaction) em Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# === Supabase Auth ===
# Use o anon key do projeto (Settings > API > anon public)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon

# === Gemini (Google AI) ===
GEMINI_API_KEY=sua-chave-gemini

# === Tunning do Funil ===
SIMILARITY_THRESHOLD=0.98
LLM_CONFIDENCE_THRESHOLD=95
EMBEDDING_BATCH_SIZE=50

# === Frontend Origin (CORS) ===
# Produção: URL exata do Vercel (ex: https://categorizador.vercel.app)
FRONTEND_URL=https://seu-app.vercel.app

# === Server (Railway injeta PORT automaticamente) ===
PORT=8000
