# === Desenvolvimento local ===
# URL do backend — usada pela Route Handler de proxy (server-side, não exposta ao browser)
BACKEND_URL=http://127.0.0.1:8000

# === Produção (Vercel) ===
# Adicione BACKEND_URL nas Environment Variables do Vercel apontando para o Railway:
# BACKEND_URL=https://categorizador-production.up.railway.app

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
